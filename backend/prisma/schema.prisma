generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   BigInt         @id /// Telegram User ID
  first_name           String
  username             String?
  ton_balance          Decimal        @default(0.000000) @db.Decimal(12, 6)
  nc_balance           BigInt         @default(0)
  power_percentage     Int            @default(100)
  power_capacity_hours Int            @default(8)
  ton_hashrate_per_sec Decimal        @default(0.00000020) @db.Decimal(12, 8)
  last_sync_at         DateTime       @default(now())
  referred_by            BigInt?
  referral_count         Int              @default(0)
  unclaimed_referral_nc  BigInt           @default(0)
  unclaimed_referral_ton Decimal          @default(0.000000) @db.Decimal(14, 6)
  total_referral_nc      BigInt           @default(0)
  total_referral_ton     Decimal          @default(0.000000) @db.Decimal(14, 6)
  photo_url              String?          @db.Text
  photo_synced_at        DateTime?
  miner_level            Int              @default(1)
  last_level_up_date     DateTime?        @db.Date
  daily_streak           Int              @default(0)
  last_daily_claim_date  DateTime?        @db.Date
  total_daily_claims     Int              @default(0)
  mining_reminder_sent    Boolean          @default(false)
  last_mining_reminder_at DateTime?
  created_at             DateTime         @default(now())
  claims                 MissionClaim[]
  withdrawals            Withdrawal[]
  game_sessions          GameSession[]
  promo_claims           UserPromoClaim[]
  referrals_made         Referral[]             @relation("Referrer")
  referred_in            Referral?              @relation("Referee")
  proof_submissions      TaskProofSubmission[]
  daily_ads              UserDailyAd[]
  withdrawal_limits      UserWithdrawalLimit?
  is_banned              Boolean                @default(false)
  ban_reason             String?                @db.Text
  risk_score             Int                    @default(0)
  primary_device_hash    String?                @db.VarChar(64)
  last_ip_address        String?                @db.VarChar(45)
  devices                UserDevice[]
  security_logs          SecurityAuditLog[]

  @@index([is_banned], name: "idx_users_banned")
  @@index([primary_device_hash], name: "idx_users_device")
  @@map("users")
}

model RewardConfig {
  action_type  String   @id @db.VarChar(32) /// 'game_play', 'watch_ad', 'task_default'
  display_name String   @db.VarChar(64)
  nc_reward    Int
  ton_reward   Decimal  @db.Decimal(12, 6)
  updated_at   DateTime @default(now()) @updatedAt

  @@map("reward_configs")
}

model DynamicMission {
  id               Int            @id @default(autoincrement())
  creator_user_id  BigInt
  title            String         @db.VarChar(120)
  description      String
  category         String         @db.VarChar(32) /// 'telegram', 'social', 'daily', 'partner'
  task_type        String         @db.VarChar(32) /// 'telegram_join', 'visit_url', 'bot_launch'
  action_url       String
  telegram_chat_id String?        @db.VarChar(64)
  nc_reward        Int
  ton_reward       Decimal        @db.Decimal(12, 6)
  target_users     Int?
  completed_count  Int            @default(0)
  is_active          Boolean                @default(true)
  priority           Int                    @default(0)
  requires_proof     Boolean                @default(false)
  proof_instructions String?                @default("Upload a screenshot showing you followed/subscribed") @db.Text
  created_at         DateTime               @default(now())
  claims             MissionClaim[]
  proof_submissions  TaskProofSubmission[]

  @@map("dynamic_missions")
}

model MissionClaim {
  id         Int            @id @default(autoincrement())
  mission_id Int
  user_id    BigInt
  claimed_at DateTime       @default(now())
  mission    DynamicMission @relation(fields: [mission_id], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, mission_id])
  @@map("mission_claims")
}

model Withdrawal {
  id                 Int       @id @default(autoincrement())
  user_id            BigInt
  ton_address        String    @db.VarChar(128)
  ton_amount         Decimal   @db.Decimal(10, 4)
  status             String    @default("PENDING") @db.VarChar(20) /// 'PENDING', 'APPROVED', 'REJECTED'
  channel_message_id BigInt?
  reviewed_by        BigInt?
  created_at         DateTime  @default(now())
  updated_at         DateTime? @default(now()) @updatedAt
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("withdrawals")
}

model GameSession {
  id          String    @id
  user_id     BigInt
  game_type   String    @db.VarChar(32) /// 'game_memory', 'game_2048', 'game_carrace'
  status      String    @default("ACTIVE") @db.VarChar(20) /// 'ACTIVE', 'COMPLETED', 'EXPIRED'
  started_at  DateTime  @default(now())
  finished_at DateTime?
  score       Int?
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("game_sessions")
}

model PromoCode {
  id            Int              @id @default(autoincrement())
  code          String           @unique @db.VarChar(32)
  nc_reward     Int              @default(500)
  ton_reward    Decimal          @default(0.000050) @db.Decimal(14, 6)
  max_claims    Int?             @default(100)
  claimed_count Int              @default(0)
  is_active     Boolean          @default(true)
  created_at    DateTime         @default(now())
  claims        UserPromoClaim[]

  @@map("promo_codes")
}

model UserPromoClaim {
  id            Int       @id @default(autoincrement())
  user_id       BigInt
  promo_code_id Int
  claimed_at    DateTime  @default(now())
  promo_code    PromoCode @relation(fields: [promo_code_id], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, promo_code_id], name: "unique_user_promo")
  @@map("user_promo_claims")
}

model Referral {
  id          Int      @id @default(autoincrement())
  referrer_id BigInt
  referee_id  BigInt   @unique
  is_premium  Boolean  @default(false)
  bonus_nc    Int
  bonus_ton   Decimal  @db.Decimal(14, 6)
  created_at  DateTime @default(now())
  referrer    User     @relation("Referrer", fields: [referrer_id], references: [id], onDelete: Cascade)
  referee     User     @relation("Referee", fields: [referee_id], references: [id], onDelete: Cascade)

  @@index([referrer_id])
  @@map("referrals")
}

model DailyStreakReward {
  day_number        Int      @id
  nc_reward         Int
  ton_reward        Decimal  @db.Decimal(14, 6)
  battery_bonus_pct Int      @default(0)
  updated_at        DateTime @default(now()) @updatedAt

  @@map("daily_streak_rewards")
}

model TaskProofSubmission {
  id                 Int            @id @default(autoincrement())
  user_id            BigInt
  mission_id         Int
  telegram_file_id   String?        @db.Text
  channel_message_id BigInt?
  status             String         @default("PENDING_REVIEW") @db.VarChar(20)
  reviewed_by        BigInt?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @default(now()) @updatedAt
  mission            DynamicMission @relation(fields: [mission_id], references: [id], onDelete: Cascade)
  user               User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, mission_id], name: "unique_pending_user_task")
  @@map("task_proof_submissions")
}

model UserDailyAd {
  user_id         BigInt
  ad_date         DateTime @default(now()) @db.Date
  adsgram_count   Int      @default(0)
  monetag_count   Int      @default(0)
  limit_ads_count Int      @default(0)
  last_ad_at      DateTime @default(now())
  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, ad_date])
  @@index([user_id, ad_date], name: "idx_user_daily_ads")
  @@map("user_daily_ads")
}

model BotChat {
  chat_id    BigInt   @id
  chat_type  String   @db.VarChar(32)
  title      String?  @db.VarChar(255)
  created_at DateTime @default(now())

  @@map("bot_chats")
}

model ReferralMilestone {
  target_count Int      @id
  display_name String   @db.VarChar(64)
  nc_reward    Int
  ton_reward   Decimal  @db.Decimal(12, 6)
  updated_at   DateTime @default(now()) @updatedAt

  @@map("referral_milestones")
}

model UserMilestoneClaim {
  id           Int      @id @default(autoincrement())
  user_id      BigInt
  target_count Int
  claimed_at   DateTime @default(now())

  @@unique([user_id, target_count], name: "unique_user_milestone")
  @@map("user_milestone_claims")
}

model UserWithdrawalLimit {
  user_id            BigInt    @id
  tracked_date       DateTime  @default(now()) @db.Date
  daily_extra_slots  Int       @default(0)
  daily_break_ads    Int       @default(0)
  tracked_week       DateTime  @default(now()) @db.Date
  weekly_extra_slots Int       @default(0)
  weekly_break_ads   Int       @default(0)
  updated_at         DateTime? @default(now()) @updatedAt
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, tracked_date], name: "idx_user_wd_limits_date")
  @@map("user_withdrawal_limits")
}

model UserDevice {
  id             Int       @id @default(autoincrement())
  user_id        BigInt
  device_hash    String    @db.VarChar(64)
  canvas_hash    String?   @db.VarChar(32)
  webgl_vendor   String?   @db.Text
  webgl_renderer String?   @db.Text
  user_agent     String?   @db.Text
  ip_address     String?   @db.VarChar(45)
  is_emulator    Boolean   @default(false)
  first_seen     DateTime  @default(now())
  last_seen      DateTime  @default(now())
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, device_hash], name: "unique_user_device")
  @@index([device_hash], name: "idx_user_devices_hash")
  @@index([ip_address], name: "idx_user_devices_ip")
  @@map("user_devices")
}

model SecurityAuditLog {
  id         Int      @id @default(autoincrement())
  user_id    BigInt?
  event_type String   @db.VarChar(40)
  severity   String   @default("HIGH") @db.VarChar(16)
  details    Json?
  created_at DateTime @default(now())
  user       User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], name: "idx_security_logs_user")
  @@map("security_audit_logs")
}




