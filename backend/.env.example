# Server Configuration
PORT=5000
NODE_ENV=development
ALLOW_DEV_AUTH=true

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nctons?schema=public"

# Telegram Bot Configuration
BOT_TOKEN="YOUR_BOT_TOKEN_HERE"
ADMIN_TELEGRAM_IDS="123456789"
ADMIN_CHANNEL_ID="-1001234567890"
PUBLIC_PAYOUT_CHANNEL_ID="@NCTONs_Payouts"
WEBAPP_URL="http://localhost:5173"

# Dual Ad Networks Configuration (Optional / Frontend)
VITE_ADSGRAM_BLOCK_ID="YOUR_ADSGRAM_BLOCK_ID"

# Notion Workspace Integration (Optional)
NOTION_API_KEY=""
NOTION_WITHDRAWALS_DATABASE_ID=""
NOTION_TASKS_DATABASE_ID=""
