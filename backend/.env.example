# Server Configuration
PORT=5000
NODE_ENV=development
ALLOW_DEV_AUTH=true

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nctons?schema=public"

# Telegram Bot Configuration
BOT_TOKEN="YOUR_BOT_TOKEN_HERE"
ADMIN_TELEGRAM_IDS="123456789"
ADMIN_CHANNEL_ID="-1001234567890"
WITHDRAWAL_GROUP_ID="-1003945146055"
PUBLIC_PAYOUT_CHANNEL_ID="@NCTONs_Payouts"
WEBAPP_URL="http://localhost:5173"

# Dual Ad Networks Configuration (Optional / Frontend)
VITE_ADSGRAM_BLOCK_ID="YOUR_ADSGRAM_BLOCK_ID"

# Notion Workspace Integration (Optional)
NOTION_API_KEY=""
NOTION_WITHDRAWALS_DATABASE_ID=""
NOTION_TASKS_DATABASE_ID=""

# Telegram Webhook & Render Keep-Alive Configuration (Prevent Sleep)
BOT_MODE="auto"                   # Options: auto (default), webhook, polling
BOT_WEBHOOK_URL=""                # e.g., https://nctons-backend.onrender.com/api/bot/webhook (Auto-detected on Render via RENDER_EXTERNAL_URL)
BOT_WEBHOOK_PATH="/api/bot/webhook"
BOT_WEBHOOK_SECRET=""             # Optional secret token (X-Telegram-Bot-Api-Secret-Token)
ENABLE_SELF_PING="true"           # Automatically pings /ping every 10 min to prevent Render sleep
KEEP_ALIVE_URL=""                 # Optional explicit URL to ping (e.g. https://nctons-backend.onrender.com/ping)
